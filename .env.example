# Copy to .env and fill in real values. NEVER commit .env.
# Phase 1 placeholder — values below are examples/placeholders only, not credentials.

# Flask
SECRET_KEY=change-me
FLASK_ENV=development

# PostgreSQL (Render provides DATABASE_URL in production)
# Local development example: postgresql+psycopg2://user:password@localhost:5432/techis_dev
DATABASE_URL=

# App
APP_NAME=TechIS Management System

# --- Email (Gmail SMTP, STARTTLS) — placeholders only, NEVER real credentials ---
# Gmail requires an App Password (2FA) — create one at https://myaccount.google.com/apppasswords
# Leave MAIL_SERVER empty to keep email delivery disabled (app runs normally).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=


